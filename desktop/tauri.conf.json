{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MindVault",
  "version": "0.3.0",
  "identifier": "com.mindvault.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "MindVault — Private AI Knowledge Assistant",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src http://127.0.0.1:8000 http://localhost:8000; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "msi", "appimage"],
    "icon": ["icons/icon.png"]
  }
}
