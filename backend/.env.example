# MindVault backend configuration is environment-driven.
# Copy to .env (backend/.env) for local development. Never commit real secrets.

# Root data directory (default: ~/.mindvault)
# MV_HOME=C:/Users/you/.mindvault

# SQLite database location (default: MV_HOME/mindvault.db)
# MV_DATABASE_URL=sqlite:///C:/Users/you/.mindvault/mindvault.db

# Directories for uploaded document files and vector indexes
# MV_DOCUMENTS_DIR=
# MV_INDEX_DIR=

# CORS: comma separated origins allowed for the API (dev frontend only by default)
MV_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Server
MV_HOST=127.0.0.1
MV_PORT=8000

# Upload limits
MV_MAX_UPLOAD_BYTES=104857600
MV_ALLOWED_EXTENSIONS=pdf,docx,txt,md,csv,json

# Ollama endpoint (local only by default)
MV_OLLAMA_URL=http://127.0.0.1:11434

# llama.cpp (optional provider) model file
# MV_LLAMA_MODEL_PATH=
# MV_LLAMA_CTX_SIZE=4096

# Embedding provider: auto (prefers sentence-transformers, falls back to hash)
# | sentence-transformers (needs mindvault[ml]) | hash (no download)
MV_EMBEDDING_PROVIDER=auto
MV_EMBEDDING_MODEL=all-MiniLM-L6-v2
MV_EMBEDDING_DIM=384
MV_CHUNK_SIZE=900
MV_CHUNK_OVERLAP=120

# Retrieval defaults
MV_TOP_K=8
MV_SIMILARITY_THRESHOLD=0.05
MV_MAX_CONTEXT_CHARS=9000

# Debug logging
MV_DEBUG=0
